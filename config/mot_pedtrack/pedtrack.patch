+
+// CARLA demo patch (autoware-pc-setup aw_overrides/mot_pedtrack): a pedestrian seen in only some lidar / camera frames
+// (30-50 m, scores 0.25-0.45) never became a track: every channel message without it decayed the existence again from
+// the last measurement (compounding, 3 channels at 10 Hz), and its low scores could not lift the existence over 0.5.
+// For PEDESTRIAN trackers only: decay once per elapsed time (half-life AW_PED_HALFLIFE s), detections count with a score
+// of at least AW_PED_SCORE, a track is published after AW_PED_MIN_HITS measurements and up to a position variance of
+// AW_PED_MAX_COV m2 (the camera's range is uncertain). AW_PED_TRACK=0: upstream.
+struct PedTrackConfig
+{
+  bool on{true};
+  float half_life{1.0f};
+  float min_score{0.75f};
+  int min_hits{3};
+  double max_cov{0.0};  // [m2] a pedestrian track is published up to this position variance (0: upstream bound)
+};
+const PedTrackConfig & pedTrackConfig()
+{
+  static const PedTrackConfig cfg = [] {
+    PedTrackConfig c;
+    if (const char * e = std::getenv("AW_PED_TRACK")) c.on = std::string(e) != "0";
+    if (const char * e = std::getenv("AW_PED_HALFLIFE")) c.half_life = std::stof(e);
+    if (const char * e = std::getenv("AW_PED_SCORE")) c.min_score = std::stof(e);
+    if (const char * e = std::getenv("AW_PED_MIN_HITS")) c.min_hits = std::stoi(e);
+    if (const char * e = std::getenv("AW_PED_MAX_COV")) c.max_cov = std::stod(e);
+    return c;
+  }();
+  return cfg;
+}
+bool isPedestrian(const std::vector<autoware::multi_object_tracker::classes::Classification> & c)
+{
+  return pedTrackConfig().on && !c.empty() &&
+         autoware::multi_object_tracker::classes::getHighestProbLabel(c) ==
+           autoware::multi_object_tracker::classes::Label::PEDESTRIAN;
+}
 }  // namespace
 
